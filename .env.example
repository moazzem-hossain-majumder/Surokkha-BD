# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Public site URL (used for metadata). Use your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
# The anon key (or the newer "publishable" key) is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Needed from Phase 2/3 onward (Edge Functions, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Later phases
# RESEND_API_KEY=
# IP_HASH_SALT=
# CRON_SECRET=
