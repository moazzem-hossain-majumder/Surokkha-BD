# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Public site URL (used for metadata). Use your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API
# The anon key (or the newer "publishable" key) is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# If your project issued a "publishable" key instead (sb_publishable_...), set
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead -- either name works.

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Needed from Phase 2/3 onward (Edge Functions, admin tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: ReliefLink / Volunteer Hub email notifications (free tier).
# Until you verify a sending domain in Resend, mail can only be sent from
# onboarding@resend.dev and only to the email on your Resend account.
RESEND_API_KEY=

# Later phases
# IP_HASH_SALT=
# CRON_SECRET=
